# Local development uses SQLite. Production must use a managed PostgreSQL URL (postgres:// is accepted).
DATABASE_URL=sqlite:///./skillbridge.db
# development or production. Production requires PostgreSQL, a JWT_SECRET, and HTTPS origins/URLs.
APP_ENV=development
GEMINI_API_KEY=
GEMINI_MODEL=
AI_PROVIDER=gemini
# Optional locally (sessions expire on restart); production requires a random secret of 32+ bytes.
JWT_SECRET=
ACCESS_TOKEN_MINUTES=60
# Comma-separated browser origins such as https://app.example.com. Leave empty for the desktop app.
ALLOWED_ORIGINS=
UPLOAD_DIR=./uploads
# Railway sets PORT automatically; the container start command honours it.
PORT=8000
# Address the desktop uses when started with "python -m desktop.main". Must be HTTPS unless loopback.
# "python -m desktop.launch_local" ignores this and uses its own local server.
BACKEND_URL=http://127.0.0.1:8000
LOG_LEVEL=INFO
